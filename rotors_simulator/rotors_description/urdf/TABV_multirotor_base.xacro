    </joint>

    <gazebo reference="${robot_namespace}/cable_4">
      <material>Gazebo/${color}</material>
    </gazebo>

    <!-- cable 5 -->
    <link name="${robot_namespace}/cable_5">
      <inertial>
        <mass value="${cable_mass}" /> 
        <origin xyz="0 0 -0.0125" rpy="0 0 0" />   
        <xacro:insert_block name="cable_inertia" />
      </inertial>

      <visual>
        <origin xyz="0 0 -0.0125" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.0025" length="0.025"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 -0.0125" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.00" length="0.0"/>
        </geometry>
      </collision>
    </link>

    <joint name="${robot_namespace}/joint_cable_5" type="revolute">  
      <origin xyz="0 0 -0.025" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <parent link="${robot_namespace}/cable_4" />
      <child link="${robot_namespace}/cable_5" />
      <limit lower="-1.0" upper="1.0" effort="0.1" velocity="1.0"/>
    </joint>

    <gazebo reference="${robot_namespace}/cable_5">
      <material>Gazebo/${color}</material>
    </gazebo>

    <!-- cable 6 -->
    <link name="${robot_namespace}/cable_6">
      <inertial>
        <mass value="${cable_mass}" /> 
        <origin xyz="0 0 -0.0125" rpy="0 0 0" />   
        <xacro:insert_block name="cable_inertia" />
      </inertial>

      <visual>
        <origin xyz="0 0 -0.0125" rpy="0 0 0" />
        <geometry>
