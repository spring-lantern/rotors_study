      </collision>
    </link>

    <joint name="${robot_namespace}/joint_cable_6" type="revolute">  
      <origin xyz="0 0 -0.025" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <parent link="${robot_namespace}/cable_5" />
      <child link="${robot_namespace}/cable_6" />
      <limit lower="-1.0" upper="1.0" effort="0.1" velocity="1.0"/>
    </joint>

    <gazebo reference="${robot_namespace}/cable_6">
      <material>Gazebo/${color}</material>
    </gazebo>

    <!-- cable 7 -->
    <link name="${robot_namespace}/cable_7">
      <inertial>
        <mass value="${cable_mass}" /> 
        <origin xyz="0 0 -0.0125" rpy="0 0 0" />   
        <xacro:insert_block name="cable_inertia" />
      </inertial>

      <visual>
        <origin xyz="0 0 -0.0125" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.0025" length="0.025"/>
        </geometry>
      </visual>

      <collision>
