    </gazebo>

  </xacro:macro>

<!-- payload -->
<xacro:macro name="payload"
    params="robot_namespace payload_mass color *payload_inertia">

    <link name="${robot_namespace}/payload">
      <inertial>
        <mass value="${payload_mass}" /> 
        <origin xyz="0 0 -0.02" rpy="0 0 0" />   
        <xacro:insert_block name="payload_inertia" />
      </inertial>

      <visual>
        <origin xyz="0 0 -0.02" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.02" length="0.04"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 -0.02" rpy="0 0 0" />
        <geometry>
          <cylinder radius="0.00" length="0.0"/>
        </geometry>
      </collision>
    </link>

    <joint name="${robot_namespace}/joint_payload" type="revolute">  
      <origin xyz="0 0 -0.025" rpy="0 0 0" />
      <axis xyz="1 0 0" />
      <parent link="${robot_namespace}/cable_7" />
      <child link="${robot_namespace}/payload" />
      <limit lower="-1.0" upper="1.0" effort="0.1" velocity="1.0"/>
    </joint>

    <gazebo reference="${robot_namespace}/payload">
      <material>Gazebo/Red</material>
    </gazebo>

  </xacro:macro>

