        </geometry>
      </collision>
    </link>

    <joint name="${robot_namespace}/joint_cable_7" type="revolute">  
      <origin xyz="0 0 -0.025" rpy="0 0 0" />
      <axis xyz="0 1 0" />
      <parent link="${robot_namespace}/cable_6" />
      <child link="${robot_namespace}/cable_7" />
